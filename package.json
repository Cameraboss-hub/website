{
  "name": "camera-boss-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-cms-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:unit": "node --test tests/*.test.mjs",
    "test:migration": "python3 tests/test_migration.py",
    "test": "npm run test:unit && npm run build && npm run test:migration"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "sanitize-html": "2.18.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
