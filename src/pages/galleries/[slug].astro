---
export const prerender = true;

import PageLayout from "../../layouts/PageLayout.astro";
import { loadGalleries } from "../../lib/galleries";

export async function getStaticPaths() {
  const galleries = await loadGalleries();
  return galleries.map((g) => ({ params: { slug: g.slug }, props: { gallery: g } }));
}

const { gallery } = Astro.props;
---

<PageLayout
  title={`${gallery.name} | CameraBoss Client Gallery`}
  description={`${gallery.photos.length} photographs by CameraBoss.`}
  current="/galleries"
  ogImage={gallery.photos[0]?.url}
>
  <!-- Gallery header -->
  <div class="mx-auto max-w-[1368px] px-6 pt-14 pb-8">
    <a href="/galleries" class="text-[11px] tracking-[0.3em] text-black/40 uppercase hover:text-[var(--color-accent)]">
      &larr; All galleries
    </a>

    <div class="mt-5 flex flex-wrap items-end justify-between gap-6">
      <div>
        <h1 class="font-[family-name:var(--font-display)] text-3xl font-light md:text-5xl">{gallery.name}</h1>
        <p class="mt-3 text-[11px] tracking-[0.25em] text-black/40 uppercase">
          {gallery.photos.length} photographs
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span id="sel-count" class="hidden text-[11px] tracking-[0.2em] text-black/50 uppercase"></span>
        <button
          id="download-btn"
          class="border border-[var(--color-ink)] px-7 py-3 text-[11px] tracking-[0.3em] uppercase transition-colors hover:bg-[var(--color-ink)] hover:text-white"
        >
          Download
        </button>
      </div>
    </div>
  </div>

  <!-- Photos: visible to everyone, no PIN -->
  <div class="mx-auto max-w-[1368px] px-6 pb-24">
    <div class="cb-masonry" id="grid">
      {gallery.photos.map((p, i) => (
        <figure class="cb-tile" data-i={i}>
          <img src={p.thumb} alt="" loading="lazy" />
          <button class="cb-pick" data-pick={i} aria-label="Select photo" hidden>
            <span class="cb-check">&#10003;</span>
          </button>
        </figure>
      ))}
    </div>
  </div>

  <!-- Download PIN dialog -->
  <div id="dl-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 px-6">
    <div class="w-full max-w-sm bg-[var(--color-paper)] p-9 text-center">
      <p class="text-[11px] tracking-[0.35em] text-black/45 uppercase">Download</p>
      <h2 class="mt-4 font-[family-name:var(--font-display)] text-2xl font-light">{gallery.name}</h2>
      <p class="mt-4 text-sm leading-relaxed text-black/55">
        Viewing is open. To download, enter the PIN from your delivery email.
      </p>
      <form id="dl-form" class="mt-7" autocomplete="off">
        <input
          id="dl-pin" type="text" inputmode="numeric" maxlength="4" required
          class="w-full border border-black/15 bg-white px-4 py-4 text-center text-2xl tracking-[0.6em] outline-none focus:border-[var(--color-accent)]"
        />
        <p id="dl-error" class="mt-3 hidden text-xs text-[var(--color-accent)]">
          That PIN doesn’t match. Please check your delivery email.
        </p>
        <button type="submit" class="mt-6 w-full bg-[var(--color-ink)] py-4 text-[11px] tracking-[0.3em] text-white uppercase hover:opacity-85">
          Unlock downloads
        </button>
      </form>
      <button id="dl-cancel" class="mt-5 text-[11px] tracking-[0.2em] text-black/40 uppercase hover:text-black">
        Cancel
      </button>
    </div>
  </div>

  <!-- Download toolbar, shown once unlocked -->
  <div id="dl-bar" class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-black/10 bg-[var(--color-paper)]/97 backdrop-blur">
    <div class="mx-auto flex max-w-[1368px] flex-wrap items-center justify-between gap-4 px-6 py-4">
      <p class="text-[11px] tracking-[0.2em] text-black/55 uppercase">
        Downloads unlocked &middot; <span id="picked">0</span> selected
      </p>
      <div class="flex flex-wrap gap-3">
        <button id="select-all" class="border border-black/20 px-5 py-2.5 text-[11px] tracking-[0.2em] uppercase hover:border-black">Select all</button>
        <button id="clear-sel" class="border border-black/20 px-5 py-2.5 text-[11px] tracking-[0.2em] uppercase hover:border-black">Clear</button>
        <button id="dl-selected" class="bg-[var(--color-ink)] px-6 py-2.5 text-[11px] tracking-[0.2em] text-white uppercase hover:opacity-85">Download selected</button>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lb" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/96">
    <button id="lb-close" class="absolute top-6 right-7 text-3xl text-white/60 hover:text-white" aria-label="Close">&times;</button>
    <button id="lb-prev" class="absolute left-3 text-4xl text-white/50 hover:text-white" aria-label="Previous">&#8249;</button>
    <img id="lb-img" src="" alt="" class="max-h-[86vh] max-w-[92vw] object-contain" />
    <button id="lb-next" class="absolute right-3 text-4xl text-white/50 hover:text-white" aria-label="Next">&#8250;</button>
    <div class="absolute bottom-6 w-full text-center">
      <p id="lb-meta" class="text-[11px] tracking-[0.2em] text-white/50 uppercase"></p>
      <a id="lb-dl" class="mt-3 hidden text-[11px] tracking-[0.25em] text-white/80 uppercase underline underline-offset-4 hover:text-white" download>
        Download this photo
      </a>
    </div>
  </div>

  <script is:inline define:vars={{ pin: gallery.pin, photos: gallery.photos, slug: gallery.slug }}>
    const KEY = "cb-dl-" + slug;
    const picked = new Set();
    let unlocked = false;

    const modal = document.getElementById("dl-modal");
    const bar = document.getElementById("dl-bar");
    const lbDl = document.getElementById("lb-dl");

    function setUnlocked() {
      unlocked = true;
      try { sessionStorage.setItem(KEY, "1"); } catch (e) {}
      modal.classList.add("hidden"); modal.classList.remove("flex");
      bar.classList.remove("hidden");
      lbDl.classList.remove("hidden");
      document.querySelectorAll(".cb-pick").forEach((b) => (b.hidden = false));
      document.body.classList.add("cb-picking");
    }
    try { if (sessionStorage.getItem(KEY) === "1") setUnlocked(); } catch (e) {}

    document.getElementById("download-btn").addEventListener("click", () => {
      if (unlocked) { bar.classList.remove("hidden"); window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" }); return; }
      modal.classList.remove("hidden"); modal.classList.add("flex");
      setTimeout(() => document.getElementById("dl-pin").focus(), 60);
    });
    document.getElementById("dl-cancel").addEventListener("click", () => {
      modal.classList.add("hidden"); modal.classList.remove("flex");
    });
    document.getElementById("dl-form").addEventListener("submit", (e) => {
      e.preventDefault();
      if (document.getElementById("dl-pin").value.trim() === String(pin)) setUnlocked();
      else document.getElementById("dl-error").classList.remove("hidden");
    });

    function refresh() {
      document.getElementById("picked").textContent = String(picked.size);
    }
    document.querySelectorAll(".cb-pick").forEach((b) =>
      b.addEventListener("click", (e) => {
        e.stopPropagation();
        const i = Number(b.dataset.pick);
        if (picked.has(i)) { picked.delete(i); b.closest(".cb-tile").classList.remove("is-picked"); }
        else { picked.add(i); b.closest(".cb-tile").classList.add("is-picked"); }
        refresh();
      })
    );
    document.getElementById("select-all").addEventListener("click", () => {
      photos.forEach((_, i) => picked.add(i));
      document.querySelectorAll(".cb-tile").forEach((t) => t.classList.add("is-picked"));
      refresh();
    });
    document.getElementById("clear-sel").addEventListener("click", () => {
      picked.clear();
      document.querySelectorAll(".cb-tile").forEach((t) => t.classList.remove("is-picked"));
      refresh();
    });

    async function grab(url, name) {
      const a = document.createElement("a");
      a.href = url; a.download = name; a.rel = "noopener";
      document.body.appendChild(a); a.click(); a.remove();
      await new Promise((r) => setTimeout(r, 350));
    }
    document.getElementById("dl-selected").addEventListener("click", async () => {
      const list = picked.size ? [...picked] : photos.map((_, i) => i);
      const btn = document.getElementById("dl-selected");
      btn.disabled = true;
      for (let n = 0; n < list.length; n++) {
        const p = photos[list[n]];
        btn.textContent = `Downloading ${n + 1} / ${list.length}`;
        await grab(p.url, `${slug}-${String(list[n] + 1).padStart(4, "0")}.jpg`);
      }
      btn.textContent = "Download selected";
      btn.disabled = false;
    });

    // Lightbox
    const lb = document.getElementById("lb");
    const lbImg = document.getElementById("lb-img");
    const lbMeta = document.getElementById("lb-meta");
    let idx = 0;
    function show(i) {
      idx = (i + photos.length) % photos.length;
      const p = photos[idx];
      lbImg.src = p.url;
      lbMeta.textContent = `${idx + 1} / ${photos.length}` + (p.resolution ? ` · ${p.resolution}` : "");
      lbDl.href = p.url;
      lbDl.setAttribute("download", `${slug}-${String(idx + 1).padStart(4, "0")}.jpg`);
      lb.classList.remove("hidden"); lb.classList.add("flex");
    }
    function hide() { lb.classList.add("hidden"); lb.classList.remove("flex"); }
    document.querySelectorAll(".cb-tile").forEach((el) =>
      el.addEventListener("click", () => show(Number(el.dataset.i)))
    );
    document.getElementById("lb-close").addEventListener("click", hide);
    document.getElementById("lb-prev").addEventListener("click", (e) => { e.stopPropagation(); show(idx - 1); });
    document.getElementById("lb-next").addEventListener("click", (e) => { e.stopPropagation(); show(idx + 1); });
    document.addEventListener("keydown", (e) => {
      if (!lb.classList.contains("hidden")) {
        if (e.key === "Escape") hide();
        if (e.key === "ArrowRight") show(idx + 1);
        if (e.key === "ArrowLeft") show(idx - 1);
      } else if (e.key === "Escape" && modal.classList.contains("flex")) {
        modal.classList.add("hidden"); modal.classList.remove("flex");
      }
    });
    refresh();
  </script>
</PageLayout>
