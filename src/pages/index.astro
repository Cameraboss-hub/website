---
// Static marketing page — prerendered to HTML at build time even though the
// site runs in `server` output mode overall (see astro.config.mjs).
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import DockExperience from "../components/sections/DockExperience.astro";
import DockIntro from "../components/sections/DockIntro.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import PortfolioGrid from "../components/sections/PortfolioGrid.astro";
import BookingCta from "../components/sections/BookingCta.astro";
import FilmCompany from "../components/sections/FilmCompany.astro";
import Packages from "../components/sections/Packages.astro";
import ExploreMore from "../components/sections/ExploreMore.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="CameraBoss | Nigeria & London Wedding Photographer">
  <main id="main-content">
    <DockIntro />
    <Hero />
    <DockExperience />
    <PortfolioGrid />
    <About />
    <FilmCompany />
    <Packages />
    <ExploreMore />
    <BookingCta />
  </main>
  <Footer />
</BaseLayout>
