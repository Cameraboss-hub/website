---
export const prerender = true;

import PageLayout from "../layouts/PageLayout.astro";
import selectedWork from "../data/portfolio.json";
import publishedStories from "../data/portfolio-stories.json";
import { coverSrc, coverSrcSet } from "../lib/portfolio-images";
import "../styles/home-new.css";

const lead = selectedWork.find((work) => work.slug === "joandjonny")!;
const storyOrder = [
  "joandjonny", "cynthiaandoswaldo", "vanessawedding",
  "temiandfiyin", "opeyemiweddingportrait",
];
const stories = storyOrder.map((slug) => {
  const story = publishedStories.find((entry) => entry.slug === slug);
  if (!story) throw new Error(`Missing homepage story: ${slug}`);
  return story;
});
const titles = new Map(selectedWork.map((work) => [work.slug, work.title]));
const storySlugs = new Set(stories.map((story) => story.slug));
const openingPhotos = [
  { slug: "cynthiaandoswaldo", index: 2 },
  { slug: "joandjonny", index: 2 },
  { slug: "opeyemiweddingportrait", index: 7 },
].map(({ slug, index }) => {
  const story = stories.find((entry) => entry.slug === slug);
  const photo = story?.photos[index];
  if (!photo) throw new Error(`Missing opening photograph: ${slug}/${index}`);
  return photo;
});

// Keep the layout stable while the lazy-loaded cover photographs arrive.
const coverDimensions: Record<string, readonly [number, number]> = {
  "faithandjack-1": [960, 1353],
  felixandlina: [960, 1286],
  carmenandben: [960, 1301],
  bambna: [960, 640],
  akinpelu: [960, 1200],
  iyanuwedding: [960, 1194],
  jumokeandstephen: [960, 768],
  mayoandemmanuel: [960, 1438],
  dana: [960, 1200],
  bridalshoot: [960, 1200],
  princessweddingportraits: [960, 1200],
  finemodelbluesuit: [960, 1200],
  reddressmodel: [960, 1440],
};
const covers = selectedWork.filter((work) => !storySlugs.has(work.slug)).map((work) => {
  const dimensions = coverDimensions[work.slug];
  if (!dimensions) throw new Error(`Missing homepage cover dimensions: ${work.slug}`);
  return {
    href: work.source_gallery,
    label: `Open ${work.title} gallery`,
    alt: `${work.title}, photographed by CameraBoss`,
    src: coverSrc(work.slug),
    srcset: coverSrcSet(work.slug),
    width: dimensions[0],
    height: dimensions[1],
  };
});
const storyPhotos = Array.from({ length: Math.max(...stories.map((story) => story.photos.length)) }, (_, index) =>
  stories.flatMap((story) => {
    const photo = story.photos[index];
    return photo ? [{
      href: `/stories/${story.slug}/`,
      label: `Open ${titles.get(story.slug)} gallery: ${photo.alt}`,
      alt: photo.alt,
      src: photo.src,
      srcset: photo.srcset,
      width: photo.width,
      height: photo.height,
    }] : [];
  }),
).flat();
// Weave cover-only galleries among the published stories for a wider range of work.
const portfolio = storyPhotos.flatMap((photo, index) => {
  const cover = index % 4 === 0 ? covers[Math.floor(index / 4)] : undefined;
  return cover ? [cover, photo] : [photo];
});
---

<PageLayout
  title="Nigerian Wedding Photographer in London & across UK"
  description="Trusted Yoruba wedding photographer in London & African wedding photographer in the UK. Serving in Leicester, Midlands & Manchester with creative wedding photography."
  current="/"
  ogImage={lead.image}
>
  <section class="home-opening" aria-labelledby="home-title">
    <div class="home-opening__pictures" aria-label="CameraBoss wedding and portrait photography">
      {openingPhotos.map((photo, index) => (
        <img
          src={photo.src}
          srcset={photo.srcset}
          sizes={index === 1 ? "(max-width: 700px) 100vw, 50vw" : "(max-width: 700px) 50vw, 25vw"}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          fetchpriority={index === 1 ? "high" : undefined}
          loading="eager"
          decoding="async"
        />
      ))}
    </div>
    <div class="home-opening__statement">
      <div>
        <p class="home-eyebrow">CameraBoss / Photography &amp; film</p>
        <h1 id="home-title">The day is yours.{" "}<br /><em>The feeling stays.</em></h1>
      </div>
      <div class="home-opening__aside">
        <p>Wedding and portrait photography for people who want to remember how it felt to be there.</p>
        <span>London · Leicester · Across the UK</span>
        <a href="/contact/">Start a conversation</a>
      </div>
    </div>
  </section>

  <section class="home-portfolio" id="portfolio" aria-labelledby="home-portfolio-title">
    <div class="home-portfolio__heading">
      <h2 id="home-portfolio-title">Selected photographs</h2>
      <span>Weddings / Portraits / People</span>
    </div>
    <div class="home-portfolio__grid">
      {portfolio.map((photo) => (
        <a class="home-portfolio__tile" href={photo.href} aria-label={photo.label}>
          <img src={photo.src} srcset={photo.srcset} sizes="(max-width: 700px) calc(50vw - 12px), (max-width: 1600px) calc(33vw - 26px), 510px" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
    <div class="home-portfolio__after">
      <p>There is more to every photograph.</p>
      <a href="/client-area/">Explore the galleries</a>
    </div>
  </section>

  <section class="home-note" aria-labelledby="home-note-title">
    <p class="home-eyebrow">CameraBoss / London · Leicester · Across the UK</p>
    <h2 id="home-note-title">The day, as it felt.</h2>
    <p>Wedding and portrait photography shaped by people, place and feeling. From Nigerian and African celebrations to quieter portraits, we make space for the moments that matter to you.</p>
    <nav aria-label="Explore CameraBoss">
      <a href="/about/">About us</a>
      <a href="/client-area/?tag=portrait">Portraits</a>
      <a href="/blog/">Journal</a>
      <a href="/contact/">Get in touch</a>
    </nav>
  </section>

  <section class="home-locations" aria-label="Photography locations">
    <p class="home-eyebrow">Where we work</p>
    <div>
      <a href="/London-wedding-photographer/">London</a>
      <a href="/Leicester-Wedding-Photographer/">Leicester</a>
      <a href="/Birmingham-wedding-photographer/">Birmingham</a>
      <a href="/manchester-wedding-photographer/">Manchester</a>
      <a href="/locations/">All locations</a>
    </div>
  </section>
</PageLayout>
