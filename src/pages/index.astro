---
export const prerender = true;

import PageLayout from "../layouts/PageLayout.astro";
import selectedWork from "../data/portfolio.json";
import { posts, isoDate, thumbFor } from "../lib/content";
import "../styles/home-new.css";

const lead = selectedWork.find((work) => work.slug === "joandjonny")!;
const storySlugs = ["faithandjack-1", "bambna", "dana", "cynthiaandoswaldo"];
const stories = storySlugs.map((slug) => selectedWork.find((work) => work.slug === slug)!);
const latest = [...posts]
  .filter((post) => isoDate(post.date))
  .sort((a, b) => isoDate(b.date)!.localeCompare(isoDate(a.date)!))
  .slice(0, 3);
---

<PageLayout
  title="Nigerian Wedding Photographer in London & across UK"
  description="Trusted Yoruba wedding photographer in London & African wedding photographer in the UK. Serving in Leicester, Midlands & Manchester with creative wedding photography."
  current="/"
  ogImage={lead.image}
>
  <section class="home-lead" aria-labelledby="home-title">
    <picture class="home-lead__media">
      <source media="(max-width: 700px)" srcset="/images/selected-work/cynthiaandoswaldo.jpg" />
      <img class="home-lead__image" src={lead.image} alt="A CameraBoss wedding celebration" width="1800" height="1200" fetchpriority="high" />
    </picture>
    <div class="home-lead__shade" aria-hidden="true"></div>
    <div class="home-lead__copy">
      <p class="home-eyebrow">CameraBoss / Photography & film</p>
      <h1 id="home-title">Wedding photography for the way it felt.</h1>
      <p>Thoughtful photographs of weddings, people and the moments between. From Nigerian celebrations to intimate portraits, we make images that bring you back.</p>
      <div class="home-lead__actions">
        <a href="/client-area/">View selected work</a>
        <a href="/contact/">Enquire</a>
      </div>
    </div>
    <p class="home-lead__credit">Jo and Jonny / CameraBoss</p>
  </section>

  <section class="home-intro" aria-label="Our work">
    <p class="home-eyebrow">London · Leicester · Across the UK</p>
    <p>We photograph the people, the atmosphere and the fleeting details that make a day unmistakably yours.</p>
  </section>

  <section class="home-stories" aria-labelledby="home-stories-title">
    <div class="home-section-head">
      <div>
        <p class="home-eyebrow">Portfolio</p>
        <h2 id="home-stories-title">Selected work</h2>
      </div>
      <p>Real weddings and portraits, seen with care.</p>
    </div>
    <div class="home-stories__grid">
      {stories.map((work) => (
        <figure class="home-story">
          <img src={work.image} alt={`${work.title} — ${work.category} photography by CameraBoss`} width="800" height="1000" loading="lazy" decoding="async" />
          <figcaption><span>{work.title}</span><small>{work.category === "wedding" ? "Wedding" : "Portrait"}</small></figcaption>
        </figure>
      ))}
    </div>
    <a class="home-inline-link" href="/client-area/">View the full selection</a>
  </section>

  <section class="home-approach" aria-labelledby="home-approach-title">
    <div class="home-approach__image">
      <img src="/images/selected-work/princessweddingportraits.jpg" alt="Bridal portrait photographed by CameraBoss" width="800" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="home-approach__copy">
      <p class="home-eyebrow">The approach</p>
      <h2 id="home-approach-title">Present for it all. Never in the way.</h2>
      <p>We learn what matters to you before the day begins. Then we make room for the traditions, energy and people that give your story its shape.</p>
      <a class="home-inline-link" href="/experience/">The CameraBoss experience</a>
    </div>
  </section>

  <section class="home-portrait" aria-labelledby="home-portrait-title">
    <div class="home-portrait__copy">
      <p class="home-eyebrow">Portraits & editorial</p>
      <h2 id="home-portrait-title">A portrait should feel like you.</h2>
      <p>Quiet confidence, colour, character. We make portraits for the person in front of the lens, whether it is a bridal session or something entirely your own.</p>
      <a class="home-inline-link" href="/client-area/?tag=portrait">Explore portraits</a>
    </div>
    <div class="home-portrait__image"><img src="/images/selected-work/dana.jpg" alt="Dana bridal portrait by CameraBoss" width="800" height="1000" loading="lazy" decoding="async" /></div>
  </section>

  <section class="home-journal" aria-labelledby="home-journal-title">
    <div class="home-section-head">
      <div><p class="home-eyebrow">Journal</p><h2 id="home-journal-title">Stories & ideas</h2></div>
      <a class="home-inline-link" href="/blog/">Read the journal</a>
    </div>
    <div class="home-journal__grid">
      {latest.map((post) => (
        <a href={`/blog/${post.slug}/`} class="home-journal__card">
          {thumbFor(post) && <img src={thumbFor(post)} alt="" width="720" height="480" loading="lazy" decoding="async" />}
          <span>{post.date}</span><h3>{post.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="home-about" aria-labelledby="home-about-title">
    <div class="home-about__image"><img src="/images/about/john-lekan-shooting.webp" alt="John Lekan photographing a wedding" width="800" height="1000" loading="lazy" decoding="async" /></div>
    <div class="home-about__copy">
      <p class="home-eyebrow">Behind the camera</p>
      <h2 id="home-about-title">John Lekan</h2>
      <p>I’m a wedding, lifestyle and portrait photographer based in the UK. I want the photographs to look like your day, and to feel like it too.</p>
      <a class="home-inline-link" href="/about/">Meet John</a>
    </div>
  </section>

  <section class="home-locations" aria-label="Photography locations">
    <p class="home-eyebrow">Where we work</p>
    <div>
      <a href="/London-wedding-photographer/">London</a>
      <a href="/Leicester-Wedding-Photographer/">Leicester</a>
      <a href="/Birmingham-wedding-photographer/">Birmingham</a>
      <a href="/manchester-wedding-photographer/">Manchester</a>
      <a href="/locations/">All locations</a>
    </div>
  </section>
</PageLayout>
