---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import selectedWork from "../../data/portfolio.json";
import "../../styles/portfolio.css";

const order = [
  "iyanuwedding", "opeyemiweddingportrait", "reddressmodel", "joandjonny", "faithandjack-1", "dana",
  "carmenandben", "bambna", "finemodelbluesuit", "cynthiaandoswaldo", "princessweddingportraits", "felixandlina",
  "mayoandemmanuel", "temiandfiyin", "bridalshoot", "akinpelu", "jumokeandstephen", "vanessawedding",
];
const position = new Map(order.map((slug, index) => [slug, index]));
const displayWork = [...selectedWork].sort((a, b) => (position.get(a.slug) ?? 999) - (position.get(b.slug) ?? 999));
const galleryLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Selected Wedding & Portrait Photography | CameraBoss",
  description: "A considered selection of real weddings and portraits photographed by CameraBoss in the UK and beyond.",
  url: "https://www.cameraboss.co.uk/client-area/",
  hasPart: selectedWork.map((work) => ({
    "@type": "ImageObject",
    name: work.title,
    contentUrl: new URL(work.image, "https://www.cameraboss.co.uk").href,
    creator: { "@type": "Organization", name: "CameraBoss" },
  })),
};
---

<PageLayout
  title="Wedding & Portrait Gallery | CameraBoss"
  description="Selected wedding stories and portrait photography by CameraBoss. Explore the work, the people and the moments that make each celebration different."
  current="/client-area/"
  ogImage={displayWork[0].image}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(galleryLd)} />
  <section class="portfolio-hero" aria-labelledby="portfolio-title">
    <div>
      <p class="portfolio-kicker">CameraBoss / Portfolio</p>
      <h1 id="portfolio-title">Selected work.</h1>
    </div>
    <p>Weddings and portraits with presence. A considered edit of the people, places and moments we have photographed.</p>
  </section>

  <section class="portfolio-work" id="selected-work" aria-label="Selected wedding and portrait photographs">
    <div class="portfolio-filters" role="group" aria-label="Filter selected work">
      <button type="button" data-portfolio-filter="all" aria-pressed="true">All work</button>
      <button type="button" data-portfolio-filter="wedding" aria-pressed="false">Weddings</button>
      <button type="button" data-portfolio-filter="portrait" aria-pressed="false">Portraits</button>
    </div>
    <div class="portfolio-grid">
      {displayWork.map((work, index) => (
        <figure class="portfolio-card" data-category={work.category}>
          <div class="portfolio-card__image">
            <img src={work.image} alt={`${work.title} — ${work.category} photography by CameraBoss`} width="800" height="1000" loading={index < 3 ? "eager" : "lazy"} decoding="async" />
          </div>
          <figcaption><span class="portfolio-card__title">{work.title}</span><span class="portfolio-card__type">{work.category === "wedding" ? "Wedding" : "Portrait"}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-portfolio-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".portfolio-card"));
    const activate = (category: string) => {
      filters.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.portfolioFilter === category)));
      cards.forEach((card) => { card.hidden = category !== "all" && card.dataset.category !== category; });
    };
    filters.forEach((button) => button.addEventListener("click", () => activate(button.dataset.portfolioFilter || "all")));
    const initial = new URLSearchParams(window.location.search).get("tag");
    if (initial === "wedding" || initial === "portrait" || initial === "portraits") activate(initial === "portraits" ? "portrait" : initial);
  </script>
</PageLayout>
