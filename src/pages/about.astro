---
export const prerender = true;

import PageLayout from "../layouts/PageLayout.astro";
import EnquiryEmbed from "../components/EnquiryEmbed.astro";
import "../styles/about-new.css";

const B = "https://htwwyqfattodfaybqgev.supabase.co/storage/v1/object/public/blog/";
const site = "https://www.cameraboss.co.uk";

// Each portrait is paired with the name immediately following it in the saved Pixieset About page.
const team = [
  { name: "Taiwo T.", role: "Business manager & photographer", image: B + "a01545a3_CBP03614-a86ba7dd-1500.webp", small: B + "5a5e0990_CBP03614-ff260019-500.webp", medium: B + "86434676_CBP03614-9e361944-1000.webp", position: "35% 39%" },
  { name: "Godfather Ope", role: "Lead videographer", image: B + "09a9ed94_IMG_4022-d1480a23-1500.webp", small: B + "48b74ba8_IMG_4022-8605ade7-500.webp", medium: B + "9fe7853d_IMG_4022-e715b4ba-1000.webp", position: "52% 23%" },
  { name: "Shugar D", role: "Make-up artist & communications manager", image: B + "b845783a_CBP02666-40217914-1500.webp", small: B + "3571b75a_CBP02666-176cded0-500.webp", medium: B + "14e325c1_CBP02666-767cc78d-1000.webp", position: "36% 27%" },
  { name: "John D", role: "Lead creative photographer", image: B + "4241bc8e_CBP03659-39f17dbf-1500.webp", small: B + "f4beaafc_CBP03659-6ebcda7b-500.webp", medium: B + "a38436a6_CBP03659-0facc326-1000.webp", position: "50% 50%" },
];

const stories = [
  { name: "Jo and Jonny", detail: "A celebration of two cultures", href: "/stories/joandjonny/", image: "/images/stories/joandjonny/02-960.webp", small: "/images/stories/joandjonny/02-480.webp", alt: "Jo and Jonny together beneath a warmly lit staircase at their wedding" },
  { name: "Temi and Fiyin", detail: "Portraits and tradition", href: "/stories/temiandfiyin/", image: "/images/stories/temiandfiyin/02-960.webp", small: "/images/stories/temiandfiyin/02-480.webp", alt: "Temi smiling in a blue gele and beaded outfit" },
  { name: "Cynthia and Oswaldo", detail: "The quieter moments", href: "/stories/cynthiaandoswaldo/", image: "/images/stories/cynthiaandoswaldo/06-960.webp", small: "/images/stories/cynthiaandoswaldo/06-480.webp", alt: "Cynthia in her wedding dress, holding flowers in the church" },
];

const aboutLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${site}/about/#page`,
  name: "About CameraBoss",
  mainEntity: {
    "@type": "Organization",
    "@id": `${site}/#business`,
    name: "CameraBoss",
    founder: { "@type": "Person", name: "John Olalekan Durojaye", alternateName: "John Lekan", jobTitle: "Photographer and creative director" },
    employee: team.map(({ name, role, image }) => ({ "@type": "Person", name, jobTitle: role, image })),
  },
};
---

<PageLayout
  title="About CameraBoss | Meet John Lekan & the Creative Team"
  description="Meet John Lekan and the CameraBoss photography and film team. Discover how we photograph Nigerian, Ghanaian and multicultural weddings in London, Leicester and across the UK."
  current="/about"
  ogImage="/images/about/john-lekan-shooting.webp"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutLd)} />

  <section class="about-hero" aria-labelledby="about-title">
    <div class="about-hero__copy">
      <p class="about-kicker">CameraBoss / About us</p>
      <h1 id="about-title">The people behind <em>the photographs.</em></h1>
      <p class="about-hero__lead">We make wedding photographs and films that feel like the people in them.</p>
      <p>Led by photographer John Lekan, CameraBoss brings a close-knit creative team to celebrations across London, Leicester, the wider UK and Nigeria. We pay attention to the grand gestures, the in-between moments and the traditions that make a day yours.</p>
      <div class="about-hero__links"><a href="#meet-the-team">Meet the team</a><a href="/client-area/">See the work</a></div>
    </div>
    <figure class="about-hero__image">
      <img src="/images/about/john-lekan-shooting.webp" width="600" height="777" alt="John Lekan preparing to photograph a bride on her wedding day" fetchpriority="high" decoding="async" />
      <figcaption>John on a wedding day / CameraBoss</figcaption>
    </figure>
  </section>

  <section class="about-intro about-shell" aria-labelledby="about-intro-title">
    <p class="about-kicker">The photographer</p>
    <div class="about-intro__grid">
      <h2 id="about-intro-title">Hi, I’m John Lekan.</h2>
      <div class="about-prose">
        <p>Photography found me after years studying communication and information technology. It gave me a way to tell the stories I had always been drawn to: people, family, beauty and the moments when a room comes alive.</p>
        <p>I met my wife while doing what I love, so I know that a wedding is more than a sequence of photographs. It is a gathering of histories, people and promises. That understanding shapes how I work with every couple.</p>
        <p>Our team photographs Nigerian, Ghanaian and other multicultural weddings, alongside portraits and celebrations of every kind. We guide you when the light or the moment calls for it, then make space for you to be fully present.</p>
        <a class="about-text-link" href="/experience/">How we work together</a>
      </div>
    </div>
  </section>

  <section class="about-team" id="meet-the-team" aria-labelledby="about-team-title">
    <div class="about-shell">
      <div class="about-section-heading">
        <div><p class="about-kicker">CameraBoss / The team</p><h2 id="about-team-title">Good work is made together.</h2></div>
        <p>Photography, film, production and the people who make a day feel easy. Meet the team behind the work.</p>
      </div>
      <ul class="about-team__grid">
        {team.map((person) => (
          <li><figure>
            <div class="about-team__portrait"><img src={person.medium} srcset={`${person.small} 500w, ${person.medium} 1000w, ${person.image} 1500w`} sizes="(max-width: 640px) 44vw, (max-width: 1024px) 22vw, 280px" alt={`Portrait of ${person.name}, ${person.role} at CameraBoss`} width="800" height="1000" loading="lazy" decoding="async" style={`object-position: ${person.position}`} /></div>
            <figcaption><strong>{person.name}</strong><span>{person.role}</span></figcaption>
          </figure></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="about-video about-shell" aria-labelledby="about-video-title">
    <div class="about-video__intro">
      <p class="about-kicker">Behind the scenes / In motion</p>
      <h2 id="about-video-title">A little closer to the day.</h2>
      <p>Watch John and the team make portraits with a client. The conversation, movement and care behind the camera matter as much as the frame you take home.</p>
    </div>
    <div class="about-video__layout">
      <div>
        <div class="about-video__frame" id="about-video-frame">
          <button class="about-video__poster" data-about-video type="button" aria-label="Play CameraBoss behind-the-scenes video from Instagram">
            <img src="/images/about/cameraboss-bts-reel-cover.jpg" width="640" height="1136" alt="John photographing a client outdoors while another CameraBoss team member works beside him" loading="lazy" decoding="async" />
            <span class="about-video__play" aria-hidden="true">Play film</span>
          </button>
        </div>
        <p class="about-video__credit">From <a href="https://www.instagram.com/reel/DbnVNZmjLvB/" target="_blank" rel="noopener noreferrer">@thecameraboss on Instagram</a>. The player loads only when you press play.</p>
      </div>
      <div class="about-video__beside">
        <p class="about-video__eyebrow">The feeling behind the frame</p>
        <p class="about-video__statement">A little direction. Room to be yourselves. Photographs that bring you back.</p>
        <img src="/images/stories/joandjonny/06-960.webp" srcset="/images/stories/joandjonny/06-480.webp 480w, /images/stories/joandjonny/06-960.webp 960w" sizes="(max-width: 760px) 90vw, 43vw" width="960" height="640" alt="Jo and Jonny with their wedding party around the cake" loading="lazy" decoding="async" />
        <a class="about-text-link" href="/stories/joandjonny/">See Jo and Jonny’s story</a>
      </div>
    </div>
  </section>

  <section class="about-work" aria-labelledby="about-work-title">
    <div class="about-shell">
      <div class="about-section-heading">
        <div><p class="about-kicker">What we make together</p><h2 id="about-work-title">The day, as it felt.</h2></div>
        <p>From quiet portraits to the colour and energy of a full celebration, every story deserves its own pace.</p>
      </div>
      <div class="about-work__grid">
        {stories.map((story) => (
          <a href={story.href} class="about-work__story">
            <img src={story.image} srcset={`${story.small} 480w, ${story.image} 960w`} sizes="(max-width: 680px) 90vw, 30vw" width="720" height="900" alt={story.alt} loading="lazy" decoding="async" />
            <span><strong>{story.name}</strong><small>{story.detail}</small></span>
          </a>
        ))}
      </div>
      <a class="about-text-link" href="/client-area/">Explore more photographs</a>
    </div>
  </section>

  <section class="about-exhibition about-shell" aria-labelledby="about-exhibition-title">
    <div class="about-exhibition__copy">
      <p class="about-kicker">Beyond the wedding day</p>
      <h2 id="about-exhibition-title">The stories keep growing.</h2>
      <p>Aworan, John’s exhibition in Lagos, brought his portrait and documentary practice into a gallery. The original CameraBoss site also records conversations about the work with Rave TV, Silverbird TV, Channels TV and TVC, alongside coverage in The Nation, Vanguard and ThisDay.</p>
      <a class="about-text-link" href="/Aworan/">Discover Aworan</a>
    </div>
    <div class="about-exhibition__images">
      <img src={B + "6f853e32_CBP05221-a289703c-1000.webp"} width="1000" height="750" alt="An interview about Aworan inside the Lagos exhibition gallery" loading="lazy" decoding="async" />
      <img src={B + "1ad27881_CBP04773-239b3eee-1000.webp"} width="1000" height="750" alt="A visitor examining photographs at the Aworan exhibition" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="about-recognition about-shell" aria-labelledby="about-recognition-title">
    <img src={B + "33e4840c_CBA09822-51a0e486-1000.webp"} width="1000" height="667" alt="John Lekan holding his Creative Visionary of the Year award with fellow attendees in London" loading="lazy" decoding="async" />
    <div><p class="about-kicker">Recognition / 2025–2026</p><h2 id="about-recognition-title">Creative Visionary of the Year.</h2><p>John Olalekan Durojaye was named Creative Visionary of the Year by the Global Reputation Forum in London. The recognition belongs alongside the everyday work we value most: the trust of the people who invite us to photograph their lives.</p><a class="about-text-link" href="/blog/cameraboss-crowned-creative-visionary-of-the-year/">Read the story</a></div>
  </section>

  <section class="about-enquire" id="enquire" aria-labelledby="about-enquire-title">
    <div class="about-shell"><p class="about-kicker">Make something memorable</p><h2 id="about-enquire-title">Tell us about your day.</h2><p>Share your date, place and the people you are bringing together. We would love to hear what matters to you.</p><EnquiryEmbed /></div>
  </section>

  <script is:inline>
    document.querySelector("[data-about-video]")?.addEventListener("click", (event) => {
      const button = event.currentTarget;
      const host = document.getElementById("about-video-frame");
      if (!(button instanceof HTMLButtonElement) || !host || host.querySelector("iframe")) return;
      const frame = document.createElement("iframe");
      frame.src = "https://www.instagram.com/reel/DbnVNZmjLvB/embed/";
      frame.title = "CameraBoss behind the scenes: John and the team photographing a client";
      frame.allow = "autoplay; encrypted-media; picture-in-picture";
      frame.allowFullscreen = true;
      host.append(frame);
      button.hidden = true;
    });
  </script>
</PageLayout>
