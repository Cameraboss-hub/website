---
export const prerender = true;

import PageLayout from "../layouts/PageLayout.astro";
import EnquiryEmbed from "../components/EnquiryEmbed.astro";
import "../styles/contact-new.css";
---

<PageLayout
  title="Contact the Best Photographer in Leicester & London | CameraBoss"
  description="Get in touch with CameraBoss to check availability for your wedding, engagement or portrait shoot across the UK and Nigeria."
  current="/contact/"
  ogImage="/images/selected-work/joanna-jonathon.webp"
>
  <div class="contact-page">
    <header class="contact-hero">
      <div class="contact-hero__copy"><p class="contact-kicker">CameraBoss / Enquiries</p><h1>Let’s talk about<br />{" "}<em>your day.</em></h1><p>Tell us what you are planning. A wedding, an engagement, a portrait session — it begins with a conversation.</p><div class="contact-hero__form" id="enquire"><EnquiryEmbed /></div></div>
      <div class="contact-hero__aside"><p class="contact-kicker">Good things to share</p><ol><li><span>01</span><p>Your date, or a few dates you have in mind</p></li><li><span>02</span><p>The venue or area you are considering</p></li><li><span>03</span><p>The moments and people you most want photographed</p></li></ol></div>
    </header>
    <section class="contact-details" aria-labelledby="contact-details-title"><div><p class="contact-kicker">A direct line</p><h2 id="contact-details-title">Prefer to talk?</h2><p>Questions about availability, photography, film or a location? Reach out in the way that suits you.</p></div><div class="contact-details__links"><a href="tel:+447823714814"><span>Call</span><strong>07823 714814</strong></a><a href="mailto:camerabossmultimedia@gmail.com"><span>Email</span><strong>camerabossmultimedia@gmail.com</strong></a><a href="https://www.instagram.com/thecameraboss" target="_blank" rel="noopener noreferrer"><span>Instagram</span><strong>@thecameraboss</strong></a></div></section>
    <section class="contact-next" aria-labelledby="contact-next-title"><p class="contact-kicker">See the work / Plan your coverage</p><h2 id="contact-next-title">Explore more of CameraBoss.</h2><div><a href="/client-area/">Explore the galleries</a><a href="/pricing/">View starting prices</a><a href="/locations/">Where we work</a></div></section>
  </div>
</PageLayout>
