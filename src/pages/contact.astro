---
export const prerender = true;

import PageLayout from "../layouts/PageLayout.astro";
import EnquiryEmbed from "../components/EnquiryEmbed.astro";
import "../styles/contact-new.css";
---

<PageLayout
  title="Contact the Best Photographer in Leicester & London | CameraBoss"
  description="Get in touch with CameraBoss to check availability for your wedding, engagement or portrait shoot across the UK and Nigeria."
  current="/contact/"
  ogImage="/images/selected-work/joanna-jonathon.webp"
>
  <div class="contact-page">
    <div class="contact-photo-strip" role="group" aria-label="Wedding photographs by CameraBoss">
      <img src="/images/contact/garden-bride.webp" alt="Bride in a white gown walking through a garden" width="640" height="427" loading="eager" fetchpriority="high" decoding="async" />
      <img src="/images/contact/yoruba-couple.webp" alt="Couple embracing in traditional Yoruba wedding attire" width="512" height="640" loading="eager" decoding="async" />
      <img src="/images/contact/teal-couple.webp" alt="Couple celebrating in matching teal Nigerian wedding attire" width="512" height="640" loading="eager" decoding="async" />
    </div>
    <header class="contact-hero">
      <div class="contact-hero__copy">
        <p class="contact-kicker">CameraBoss / Enquiries</p>
        <h1>Let’s talk about<br />{" "}<em>your day.</em></h1>
        <p>Tell us what you are planning. A wedding, an engagement, a portrait session — it begins with a conversation.</p>
        <div class="contact-hero__form" id="enquire"><EnquiryEmbed /></div>
      </div>
      <figure class="contact-hero__photo">
        <img src="/images/selected-work/web/vanessawedding-960.webp" srcset="/images/selected-work/web/vanessawedding-960.webp 960w, /images/selected-work/web/vanessawedding-1600.webp 1600w" sizes="(max-width: 900px) 100vw, 40vw" alt="Wedding couple sharing a quiet moment in traditional attire" width="960" height="1200" loading="lazy" decoding="async" />
      </figure>
    </header>
    <section class="contact-details" aria-labelledby="contact-details-title"><div><p class="contact-kicker">A direct line</p><h2 id="contact-details-title">Prefer to talk?</h2><p>Questions about availability, photography, film or a location? Reach out in the way that suits you.</p></div><div class="contact-details__links"><a href="tel:+447823714814"><span>Call</span><strong>07823 714814</strong></a><a href="mailto:camerabossmultimedia@gmail.com"><span>Email</span><strong>camerabossmultimedia@gmail.com</strong></a><a href="https://www.instagram.com/thecameraboss" target="_blank" rel="noopener noreferrer"><span>Instagram</span><strong>@thecameraboss</strong></a></div></section>
    <section class="contact-next" aria-labelledby="contact-next-title"><p class="contact-kicker">See the work / Plan your coverage</p><h2 id="contact-next-title">Explore more of CameraBoss.</h2><div><a href="/client-area/">Explore the galleries</a><a href="/pricing/">View starting prices</a><a href="/locations/">Where we work</a></div></section>
  </div>
</PageLayout>
