---
import "../styles/global.css";
import "../styles/editorial.css";
import "../styles/immersive.css";
import "../styles/photo-pattern.css";
import "../styles/white.css";
import "../styles/dock.css";
import EditorialMotion from "../components/EditorialMotion.astro";
import Analytics from "../components/Analytics.astro";
import SiteInteractions from "../components/SiteInteractions.astro";
import { seoFor } from "../lib/seo";
import MobileNav from "../components/MobileNav.astro";
import { CRM_ORIGIN } from "../lib/crm";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title: suppliedTitle,
  description: suppliedDescription = "CameraBoss — London & Leicester wedding, portrait and destination photographer covering the UK and Nigeria.",
  ogImage = "/images/hero/slide-01-london.webp",
} = Astro.props;

const { title, description } = seoFor(Astro.url.pathname, { title: suppliedTitle, description: suppliedDescription });

const site = "https://www.cameraboss.co.uk";
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;

const orgLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "@id": `${site}/#business`,
  name: "CameraBoss",
  alternateName: "Camera Boss Multimedia",
  description:
    "Award-winning wedding, portrait and editorial photography and videography across the UK and Nigeria.",
  url: site,
  telephone: "+44 7823 714814",
  email: "camerabossmultimedia@gmail.com",
  image: `${site}/images/brand/cameraboss-logo.png`,
  logo: `${site}/images/brand/cameraboss-logo.png`,
  priceRange: "££",
  founder: {
    "@type": "Person",
    name: "John Olalekan Durojaye",
    alternateName: "Cameraboss",
    jobTitle: "Photographer & Creative Director",
  },
  address: { "@type": "PostalAddress", addressLocality: "Leicester", addressCountry: "GB" },
  areaServed: [
    "London", "Leicester", "Manchester", "Birmingham", "Liverpool", "Newcastle",
    "Derby", "Luton", "Oxford", "Nottingham", "Sheffield", "United Kingdom", "Nigeria",
  ].map((n) => ({ "@type": "Place", name: n })),
  knowsAbout: [
    "Wedding photography", "Nigerian traditional wedding photography",
    "Engagement photography", "Portrait photography", "Wedding videography",
  ],
  sameAs: ["https://www.instagram.com/thecameraboss", "https://wa.me/447823714814"],
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "CameraBoss",
  url: site,
  publisher: { "@id": `${site}/#business` },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#fafaf8" />
    <meta name="author" content="John Olalekan Durojaye" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="CameraBoss" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The enquiry form is served from the CRM; warm the connection early. -->
    <link rel="preconnect" href={CRM_ORIGIN} />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="top" class="editorial-site cinematic-home white-theme dock-theme">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
    <MobileNav current="/" />
    <SiteInteractions />
    <EditorialMotion />
    <Analytics />
  </body>
</html>
