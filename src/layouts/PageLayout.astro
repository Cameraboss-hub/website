---
import "../styles/global.css";
import "../styles/editorial.css";
import "../styles/pixieset-blocks.css";
import "../styles/interior.css";
import "../styles/white.css";
import "../styles/dock.css";
import EditorialMotion from "../components/EditorialMotion.astro";
import Analytics from "../components/Analytics.astro";
import SiteInteractions from "../components/SiteInteractions.astro";
import { seoFor } from "../lib/seo";
import SiteHeader from "../components/SiteHeader.astro";
import MobileNav from "../components/MobileNav.astro";
import Footer from "../components/Footer.astro";
import { CRM_ORIGIN } from "../lib/crm";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  current?: string;
  article?: { published?: string; modified?: string };
}

const {
  title: suppliedTitle,
  description: suppliedDescription = "CameraBoss — London & Leicester wedding, portrait and destination photographer.",
  ogImage,
  canonical,
  noindex = false,
  current = "",
  article,
} = Astro.props;

const { title, description } = seoFor(Astro.url.pathname, { title: suppliedTitle, description: suppliedDescription });

const site = "https://www.cameraboss.co.uk";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;

/**
 * Site-wide LocalBusiness schema. CameraBoss serves specific UK cities, so
 * areaServed is enumerated — this is what drives "wedding photographer near me"
 * style local results.
 */
const orgLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "@id": `${site}/#business`,
  name: "CameraBoss",
  alternateName: "Camera Boss Multimedia",
  description:
    "Award-winning wedding, portrait and editorial photography and videography across the UK and Nigeria.",
  url: site,
  telephone: "+44 7823 714814",
  email: "camerabossmultimedia@gmail.com",
  image: `${site}/images/brand/cameraboss-logo.png`,
  logo: `${site}/images/brand/cameraboss-logo.png`,
  priceRange: "££",
  founder: {
    "@type": "Person",
    name: "John Olalekan Durojaye",
    alternateName: "Cameraboss",
    jobTitle: "Photographer & Creative Director",
  },
  address: { "@type": "PostalAddress", addressLocality: "Leicester", addressCountry: "GB" },
  areaServed: [
    "London", "Leicester", "Manchester", "Birmingham", "Liverpool", "Newcastle",
    "Derby", "Luton", "Oxford", "Nottingham", "Sheffield", "United Kingdom", "Nigeria",
  ].map((n) => ({ "@type": "Place", name: n })),
  knowsAbout: [
    "Wedding photography", "Nigerian traditional wedding photography",
    "Engagement photography", "Portrait photography", "Wedding videography",
  ],
  sameAs: [
    "https://www.instagram.com/thecameraboss",
    "https://wa.me/447823714814",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="CameraBoss" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {article?.published && <meta property="article:published_time" content={article.published} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Images are served from Supabase Storage; connecting early improves LCP. -->
    <link rel="preconnect" href="https://htwwyqfattodfaybqgev.supabase.co" crossorigin />
    <link rel="dns-prefetch" href="https://htwwyqfattodfaybqgev.supabase.co" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The enquiry form is served from the CRM; warm the connection early. -->
    <link rel="preconnect" href={CRM_ORIGIN} />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="theme-color" content="#fafaf8" />
    <meta name="author" content="John Olalekan Durojaye" />
    <meta property="og:locale" content="en_GB" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <slot name="head" />
  </head>
  <body id="top" class="editorial-site cinematic-interior white-theme dock-theme" data-page={Astro.url.pathname}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileNav current={current} />
    <SiteInteractions />
    <EditorialMotion />
    <Analytics />
  </body>
</html>
