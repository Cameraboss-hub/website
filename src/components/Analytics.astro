---
// Analytics is optional and is loaded only after an explicit visitor choice.
const ga = import.meta.env.PUBLIC_GA_ID;
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---
{(ga || plausible) && (
  <script is:inline define:vars={{ ga, plausible }}>
    (() => {
      const key = "cameraboss-analytics-consent-v1";
      let loaded = false;
      const load = () => {
        if (loaded) return;
        loaded = true;
        if (plausible) {
          const script = document.createElement("script");
          script.defer = true;
          script.dataset.domain = plausible;
          script.src = "https://plausible.io/js/script.js";
          document.head.appendChild(script);
        }
        if (ga) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", ga, { anonymize_ip: true });
          const script = document.createElement("script");
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga)}`;
          document.head.appendChild(script);
        }
      };
      const accepted = () => {
        try { return localStorage.getItem(key) === "accepted"; } catch { return false; }
      };
      if (accepted()) load();
      document.addEventListener("cameraboss:analytics-consent", (event) => {
        if (event.detail === "accepted") load();
        // Reload after withdrawal so analytics scripts do not run on later pages.
        if (event.detail === "rejected" && loaded) {
          if (ga && window.gtag) window.gtag("consent", "update", { analytics_storage: "denied" });
          window.location.reload();
        }
      });
    })();
  </script>
)}
