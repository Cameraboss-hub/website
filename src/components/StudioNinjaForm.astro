---
interface Props { id?: string }
const { id = 'cameraboss-enquiry' } = Astro.props;
---
<div class="mx-auto max-w-[860px] px-6">
  <iframe
    id={id}
    title="CameraBoss booking enquiry form"
    src="https://app.studioninja.co/contactform/parser/0a800fc9-7a7c-1768-817a-a68817ea5956/0a800fc9-7ac4-1365-817b-0817cb5472ce"
    height="720"
    loading="lazy"
    class="w-full border-0"
  ></iframe>
  <p class="mt-4 text-center text-sm">
    <a href="https://app.studioninja.co/contactform/parser/0a800fc9-7a7c-1768-817a-a68817ea5956/0a800fc9-7ac4-1365-817b-0817cb5472ce" target="_blank" rel="noopener" class="underline underline-offset-4">Open the enquiry form in a new tab</a>
  </p>
</div>
