---
/**
 * The Cameraboss CRM enquiry form opens as a full page. The CRM currently
 * refuses cross-origin framing, so an iframe here would be a dead end.
 */
import { ENQUIRY_PAGE_URL } from "../lib/crm";
---

<div class="cameraboss-enquiry-action">
  <p>Tell us about your date and plans using the CameraBoss enquiry form.</p>
  <a href={ENQUIRY_PAGE_URL}>Open the enquiry form</a>
</div>
