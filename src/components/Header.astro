---
// Overlays the hero on the homepage.
// Same nav shape as the Pixieset original: Home · About · Info▾ | logo | Blog · Galleries · Videos · Contact
// Below `lg` this collapses to the burger, which opens <MobileNav /> — rendered
// by the layout rather than here, so the fixed drawer can cover the viewport
// instead of being trapped inside the hero's stacking context.
import { left, info, right } from "../lib/nav";

const linkCls =
  "text-xs font-medium tracking-[0.2em] text-white uppercase transition-opacity hover:opacity-70";
---

<header class="absolute inset-x-0 top-0 z-30">
  <nav
    class="mx-auto flex h-20 max-w-[1368px] items-center justify-between px-6 lg:h-25"
    aria-label="Primary"
  >
    <ul class="hidden flex-1 items-center gap-8 lg:flex">
      {left.map((item) => (
        <li><a href={item.href} class={linkCls}>{item.label}</a></li>
      ))}
      <li class="cb-nav-dd relative">
        <button type="button" class={`cb-nav-dd__btn flex items-center gap-1.5 ${linkCls}`} aria-haspopup="true" aria-expanded="false">
          Info
          <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true" class="cb-nav-dd__caret">
            <path d="M1 1.25 4.5 4.75 8 1.25" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="cb-nav-dd__menu absolute top-full left-0 z-50 w-56 border border-white/15 bg-black/85 py-2 shadow-xl backdrop-blur">
          {info.map((item) => (
            <li>
              <a href={item.href} class="block px-5 py-2.5 text-[11px] tracking-[0.18em] text-white uppercase transition-colors hover:bg-white/10">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </li>
    </ul>

    {/* Balances the burger so the logo sits centred on phones too. */}
    <span class="w-11 shrink-0 lg:hidden" aria-hidden="true"></span>

    <a href="/" class="shrink-0 lg:px-6" aria-label="CameraBoss home">
      <img src="/images/brand/cameraboss-logo.png" alt="CameraBoss" width="150" height="24" class="h-6 w-auto" />
    </a>

    <ul class="hidden flex-1 items-center justify-end gap-8 lg:flex">
      {right.map((item) => (
        <li><a href={item.href} class={linkCls}>{item.label}</a></li>
      ))}
    </ul>

    <button
      type="button"
      class="cb-burger shrink-0 text-white lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="cb-mobile-nav"
      data-mnav-open
    >
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>
