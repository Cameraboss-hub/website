---
/**
 * Mobile navigation drawer (below `lg`).
 *
 * It replaces the 224px <details> dropdown that stacked all fourteen links as
 * 11px uppercase text: too small to read, too tight to tap, and with no
 * hierarchy at all. Here the six bar links come first at readable size, the
 * eight Info pages follow as a labelled secondary group, and every target
 * clears 44px.
 *
 * The panel is rendered by the *layout*, not by the header, on purpose. Both
 * headers sit inside a backdrop-filter / stacking context, and a
 * `position: fixed` child of either would be trapped there rather than
 * covering the viewport. The burger buttons live in the headers and reach
 * this panel through `data-mnav-open` + aria-controls.
 */
import { primary, info, isCurrent } from "../lib/nav";

interface Props {
  current?: string;
}
const { current = "" } = Astro.props;
---

<div id="cb-mobile-nav" class="cb-mnav" hidden>
  <div class="cb-mnav__scrim" data-mnav-close></div>

  <div class="cb-mnav__panel" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="cb-mnav__head">
      <a href="/" class="cb-mnav__logo" aria-label="CameraBoss home">
        <img src="/images/brand/cameraboss-logo.png" alt="CameraBoss" width="150" height="24" />
      </a>
      <button type="button" class="cb-mnav__close" data-mnav-close aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M1 1 17 17M17 1 1 17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="cb-mnav__nav" aria-label="Mobile">
      <ul class="cb-mnav__list">
        {primary.map((item) => (
          <li>
            <a
              href={item.href}
              class="cb-mnav__link"
              aria-current={isCurrent(current, item.href) ? "page" : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>

      <p class="cb-mnav__label" id="cb-mnav-info">Info</p>
      <ul class="cb-mnav__list cb-mnav__list--sub" aria-labelledby="cb-mnav-info">
        {info.map((item) => (
          <li>
            <a
              href={item.href}
              class="cb-mnav__link cb-mnav__link--sub"
              aria-current={isCurrent(current, item.href) ? "page" : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>

      <div class="cb-mnav__cta">
        <a href="/contact/">Check your date</a>
      </div>

      <div class="cb-mnav__meta">
        <a href="https://wa.me/447823714814" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href="https://www.instagram.com/thecameraboss" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="mailto:camerabossmultimedia@gmail.com">Email</a>
      </div>
    </nav>
  </div>
</div>

<script>
  const root = document.getElementById("cb-mobile-nav");
  const panel = root?.querySelector<HTMLElement>(".cb-mnav__panel");
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-mnav-open]"),
  );

  if (root && panel && triggers.length) {
    let lastTrigger: HTMLElement | null = null;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;

    const isOpen = () => root.classList.contains("is-open");

    const focusable = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      );

    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== "Tab") return;
      // Keep keyboard focus inside the drawer while it covers the page.
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function open(trigger: HTMLElement) {
      if (isOpen()) return;
      clearTimeout(hideTimer);
      lastTrigger = trigger;
      root!.hidden = false;
      // Force a reflow so the panel animates in from its off-screen start
      // instead of appearing already in place.
      void root!.offsetWidth;
      root!.classList.add("is-open");
      document.documentElement.classList.add("cb-nav-locked");
      triggers.forEach((t) => t.setAttribute("aria-expanded", "true"));
      panel!.querySelector<HTMLElement>("[data-mnav-close]")?.focus();
      document.addEventListener("keydown", onKeydown);
    }

    function close() {
      if (!isOpen()) return;
      root!.classList.remove("is-open");
      document.documentElement.classList.remove("cb-nav-locked");
      triggers.forEach((t) => t.setAttribute("aria-expanded", "false"));
      document.removeEventListener("keydown", onKeydown);
      // Stay in the DOM until the slide-out has finished.
      hideTimer = setTimeout(() => {
        root!.hidden = true;
      }, 340);
      lastTrigger?.focus();
      lastTrigger = null;
    }

    triggers.forEach((t) => t.addEventListener("click", () => open(t)));
    root
      .querySelectorAll<HTMLElement>("[data-mnav-close]")
      .forEach((el) => el.addEventListener("click", () => close()));
    // A tap on any link is a navigation — close so the drawer isn't still
    // open behind same-page anchors or when the browser restores the page.
    panel.querySelectorAll("a[href]").forEach((a) => a.addEventListener("click", () => close()));
    window.addEventListener("pageshow", () => close());
    window
      .matchMedia("(min-width: 1024px)")
      .addEventListener("change", (e) => {
        if (e.matches) close();
      });
  }
</script>
