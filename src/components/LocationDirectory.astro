---
import { locationPages, locationStory, locationByName, serviceAreas } from "../data/locations";

const featuredNames = ["London", "Leicester", "Oxford", "Sheffield"];
const featured = featuredNames.map((name) => locationByName.get(name)!);
const more = locationPages.filter((page) => !featuredNames.includes(page.name));
---

<div class="loc-directory">
  <header class="loc-dir-hero">
    <div class="loc-dir-hero__copy"><p class="loc-kicker">CameraBoss / Across the UK</p><h1>Every place.<br />{" "}<em>Every feeling.</em></h1><p>London streets. Leicester gardens. A ceremony in Sheffield. Wherever the story takes you, we photograph the people at its heart.</p><a class="loc-button" href="/contact/">Enquire about your date</a></div>
    <div class="loc-dir-hero__images">{featured.slice(0, 2).map((page, index) => { const story = locationStory(page); return <a href={page.path} aria-label={`Explore ${page.name} photography`}><img src={page.image || story.image || "/images/selected-work/joandjonny.jpg"} alt={story.title} width="700" height="900" loading={index === 0 ? "eager" : "lazy"} decoding="async" /><span>{page.name}</span></a>; })}</div>
  </header>

  <section class="loc-dir-featured" aria-labelledby="loc-featured-title"><div class="loc-dir-section-heading"><p class="loc-kicker">Start exploring</p><h2 id="loc-featured-title">Places in focus.</h2></div><div class="loc-dir-featured__grid">{featured.map((page) => { const story = locationStory(page); return <a href={page.path}><img src={page.image || story.image || "/images/selected-work/joandjonny.jpg"} alt="" width="700" height="850" loading="lazy" decoding="async" /><span><strong>{page.name}</strong><small>{page.region}</small></span></a>; })}</div></section>

  <section class="loc-dir-list" aria-labelledby="loc-all-title"><div class="loc-dir-section-heading"><p class="loc-kicker">More places, more stories</p><h2 id="loc-all-title">Explore by location.</h2></div><div class="loc-dir-list__grid">{more.map((page) => <a href={page.path}><span>{page.name}</span><small>{page.region}</small></a>)}</div></section>

  <section class="loc-dir-regions" aria-labelledby="loc-regions-title"><div class="loc-dir-section-heading"><p class="loc-kicker">Beyond the map</p><h2 id="loc-regions-title">Across the United Kingdom.</h2><p>These are areas we can discuss for your wedding or portrait session. Where we have a published story, the city opens to its own page.</p></div><div class="loc-dir-regions__grid">{serviceAreas.map((group) => <div><h3>{group.region}</h3><div>{group.places.map((name) => { const page = locationByName.get(name); return page ? <a href={page.path}>{name}</a> : <span>{name}</span>; })}</div></div>)}</div></section>

  <section class="loc-last" aria-labelledby="loc-dir-last-title"><p class="loc-kicker">Have somewhere else in mind?</p><h2 id="loc-dir-last-title">We can come to you.</h2><p>Tell us the venue, date and what you are planning. We will talk through the details together.</p><a class="loc-button loc-button--light" href="/contact/">Start your enquiry</a></section>
</div>
