---
// Matches the Pixieset footer, which lists the Info pages flat rather than
// nesting them behind a dropdown.
const nav = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Pricing", href: "/pricing/" },
  { label: "Testimonials", href: "/testimonials/" },
  { label: "Experience", href: "/experience/" },
  { label: "Classes", href: "/classes/" },
  { label: "Aworan", href: "/Aworan/" },
  { label: "MyGears", href: "/MyGears/" },
  { label: "Editorial Shoot", href: "/Editorial-Shoot/" },
  { label: "Area We Cover", href: "/locations/" },
  { label: "Blog", href: "/blog/" },
  { label: "Galleries", href: "/client-area/" },
  { label: "Videos", href: "/Wedding-videos/" },
  { label: "Contact", href: "/contact/" },
];

const socials = [
  { label: "Facebook", href: "https://facebook.com/cameraboss", icon: "/images/social/facebook.svg" },
  { label: "Instagram (John Lekan)", href: "https://instagram.com/iamjohnlekan", icon: "/images/social/instagram-1.svg" },
  { label: "Instagram (CameraBoss)", href: "https://instagram.com/thecameraboss", icon: "/images/social/instagram-2.svg" },
  { label: "TikTok", href: "https://www.tiktok.com/@the_cameraboss", icon: "/images/social/tiktok.svg" },
  { label: "Pinterest", href: "https://www.pinterest.co.uk/Cameraboss/", icon: "/images/social/pinterest.svg" },
  { label: "YouTube", href: "https://www.youtube.com/@CameraBossMedia/featured", icon: "/images/social/youtube.svg" },
];



const year = new Date().getFullYear();
---
<footer class="editorial-footer">
 <div class="section-shell footer-invitation"><div><p class="eyebrow">CameraBoss / Photography &amp; film</p><h2>Let's talk about your day.</h2></div><a href="/contact/" class="footer-enquire">Enquire</a></div>
 <div class="section-shell footer-content"><div class="footer-identity"><a href="/" aria-label="CameraBoss home"><img src="/images/brand/cameraboss-logo.png" alt="CameraBoss" width="180" height="29" /></a><p>Wedding photography &amp; cinematic films.<br />Across the UK, Nigeria and beyond.</p><a href="https://www.instagram.com/thecameraboss" target="_blank" rel="noopener noreferrer">Instagram / @thecameraboss</a></div><nav aria-label="Footer"><ul>{nav.map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></nav></div>
 <div class="section-shell footer-bottom"><p>© {year} Cameraboss</p><ul>{socials.map(s=><li><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}><img src={s.icon} alt="" width="18" height="18" /></a></li>)}</ul><button type="button" data-cookie-settings class="footer-cookie-settings">Cookie settings</button><a href="#top">Back to top</a></div>
</footer>
<style>
  .footer-cookie-settings { min-height: 44px; border: 0; padding: 0; background: none; color: inherit; font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .footer-cookie-settings:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
