---
import { left, info, right, isCurrent } from '../lib/nav';
interface Props { current?: string }
const { current = '' } = Astro.props;
---
<header class="editorial-header">
  <nav class="editorial-nav" aria-label="Primary">
    <a href="/" class="editorial-brand" aria-label="CameraBoss home"><img src="/images/brand/cameraboss-logo.png" alt="CameraBoss" width="150" height="24" /><span>Photography &amp; film</span></a>
    <ul class="editorial-links">
      {left.map(item => <li><a href={item.href} aria-current={isCurrent(current,item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      <li class="cb-nav-dd"><button class="cb-nav-dd__btn" aria-haspopup="true" aria-expanded="false" type="button">Info <span aria-hidden="true">⌄</span></button>
        <ul class="cb-nav-dd__menu editorial-dropdown">{info.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </li>
      {right.map(item => <li><a href={item.href} aria-current={isCurrent(current,item.href) ? 'page' : undefined} class:list={[item.label === 'Contact' && 'nav-enquire']}>{item.label}<span class="nav-arrow" aria-hidden="true"> ↗</span></a></li>)}
    </ul>
    <button type="button" class="cb-burger editorial-burger" aria-label="Open menu" aria-expanded="false" aria-controls="cb-mobile-nav" data-mnav-open><span></span><span></span><span></span></button>
  </nav>
</header>
