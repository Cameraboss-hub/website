---
// Solid header for interior pages (blog, galleries, static pages).
// Mirrors the Pixieset nav exactly: Home · About · Info▾ | logo | Blog · Galleries · Videos · Contact
// Below `lg` this collapses to the burger, which opens <MobileNav /> — rendered
// by PageLayout rather than here, because this header carries a backdrop-filter
// and would otherwise become the containing block for the fixed drawer.
import { left, info, right, isCurrent } from "../lib/nav";

interface Props {
  current?: string;
}
const { current = "" } = Astro.props;
const isOn = (href: string) => isCurrent(current, href);
const infoOpen = info.some((i) => isOn(i.href));
const linkCls = "text-xs font-medium tracking-[0.2em] uppercase transition-colors hover:text-[var(--color-accent)]";
---

<header class="sticky top-0 z-40 border-b border-black/8 bg-[var(--color-paper)]/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-[1368px] items-center justify-between px-6 lg:h-20" aria-label="Primary">
    <ul class="hidden flex-1 items-center gap-8 lg:flex">
      {left.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[linkCls, isOn(item.href) ? "text-[var(--color-accent)]" : "text-[var(--color-ink)]"]}
          >{item.label}</a>
        </li>
      ))}
      <li class="cb-nav-dd relative">
        <button
          type="button"
          class:list={[linkCls, "cb-nav-dd__btn flex items-center gap-1.5", infoOpen ? "text-[var(--color-accent)]" : "text-[var(--color-ink)]"]}
          aria-haspopup="true"
          aria-expanded="false"
        >
          Info
          <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true" class="cb-nav-dd__caret">
            <path d="M1 1.25 4.5 4.75 8 1.25" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="cb-nav-dd__menu absolute top-full left-0 z-50 w-56 border border-black/10 bg-[var(--color-paper)] py-2 shadow-xl">
          {info.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "block px-5 py-2.5 text-[11px] tracking-[0.18em] uppercase transition-colors hover:bg-black/5 hover:text-[var(--color-accent)]",
                  isOn(item.href) ? "text-[var(--color-accent)]" : "text-[var(--color-ink)]",
                ]}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </li>
    </ul>

    {/* Balances the burger so the logo sits centred on phones too. */}
    <span class="w-11 shrink-0 lg:hidden" aria-hidden="true"></span>

    <a href="/" class="shrink-0 lg:px-6" aria-label="CameraBoss home">
      <img src="/images/brand/cameraboss-logo.png" alt="CameraBoss" width="150" height="24" class="h-6 w-auto" />
    </a>

    <ul class="hidden flex-1 items-center justify-end gap-8 lg:flex">
      {right.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[linkCls, isOn(item.href) ? "text-[var(--color-accent)]" : "text-[var(--color-ink)]"]}
          >{item.label}</a>
        </li>
      ))}
    </ul>

    <button
      type="button"
      class="cb-burger shrink-0 text-[var(--color-ink)] lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="cb-mobile-nav"
      data-mnav-open
    >
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>
