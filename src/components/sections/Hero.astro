---
import Header from "../Header.astro";

interface Slide {
  image: string;
  eyebrow?: string;
  title: string[];
  subtitle: string;
  cta?: { label: string; href: string };
}

const slides: Slide[] = [
  {
    image: "/images/hero/slide-01-london.png",
    title: ["London Wedding", "Photographer"],
    subtitle: "Moses Bliss Wedding",
    cta: { label: "View Portfolio", href: "/galleries" },
  },
  {
    image: "/images/hero/slide-02-west-midlands.png",
    title: ["Wedding Photographer in", "West Midland Leicester"],
    subtitle: "Leicester Based wedding Photographer",
    cta: { label: "View Portfolio", href: "/galleries" },
  },
  {
    image: "/images/hero/slide-03-portrait.png",
    title: ["Pre-wedding / Portrait", "photographer"],
    subtitle: "Prewedding and Engagement shoot ideas",
    cta: { label: "View Portfolio", href: "/galleries" },
  },
  {
    image: "/images/hero/slide-04-civil-wedding.png",
    title: ["Civil Wedding", "Photographer"],
    subtitle: "Award Winning Wedding Photographer | London and Leicester based",
  },
  {
    image: "/images/hero/slide-05-destination.png",
    title: ["Destination Wedding", "Photographer and Videographer"],
    subtitle: "LONDON WEDDING PHOTOGRAPHER & VIDEOGRAPHER",
    cta: { label: "Get in touch", href: "/contact" },
  },
  {
    image: "/images/hero/slide-06-nigeria-wedding.png",
    title: ["Nigeria Wedding", "Photographer in UK"],
    subtitle: "I am a Nigeria wedding Photographer based in Leicester United Kingdom",
    cta: { label: "Portfolio", href: "/galleries" },
  },
];
---

<section class="relative isolate h-screen min-h-[640px] w-full overflow-hidden bg-black" data-hero-slider>
  <Header />

  {
    slides.map((slide, i) => (
      <div
        class="absolute inset-0 transition-opacity duration-1000 ease-in-out"
        class:list={[i === 0 ? "opacity-100" : "opacity-0 pointer-events-none"]}
        data-slide={i}
      >
        <img
          src={slide.image}
          alt={`${slide.title.join(" ")} — ${slide.subtitle}`}
          class="absolute inset-0 h-full w-full object-cover"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "low"}
        />
        <div class="absolute inset-0 bg-black/20" />
        <div class="relative flex h-full items-center justify-center px-6">
          <div class="max-w-[744px] text-center text-white">
            {/* One <h1> per page: the first slide carries it, the rest are
                headings of equal visual weight but lower rank. */}
            <Fragment set:html={`<${i === 0 ? "h1" : "h2"} class="font-display text-4xl leading-tight font-light text-balance sm:text-6xl lg:text-[85px] lg:leading-[1]">${slide.title
              .map((line) => `<span class="block">${line}</span>`)
              .join("")}</${i === 0 ? "h1" : "h2"}>`} />
            <p class="mt-6 text-sm font-medium tracking-[0.06em] uppercase">
              {slide.subtitle}
            </p>
            {slide.cta && (
              <a
                href={slide.cta.href}
                class="mt-8 inline-block rounded-full border border-white px-10 py-3.5 text-xs font-semibold tracking-[0.1em] text-white uppercase transition-colors hover:bg-white hover:text-black"
              >
                {slide.cta.label}
              </a>
            )}
          </div>
        </div>
      </div>
    ))
  }

  <div class="absolute inset-x-0 bottom-5 z-20 flex items-center justify-center gap-10 px-8">
    <button
      type="button"
      class="-m-3 p-3 text-white/80 transition-colors hover:text-white"
      aria-label="Previous slide"
      data-hero-prev
    >
      <svg width="10" height="18" viewBox="0 0 10 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 1L1 9L9 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="flex items-center gap-4 sm:gap-3" role="tablist" aria-label="Slides">
      {
        slides.map((_, i) => (
          <button
            type="button"
            role="tab"
            aria-label={`Go to slide ${i + 1}`}
            aria-selected={i === 0}
            class="relative size-2 rounded-full border border-white transition-colors before:absolute before:-inset-2.5 before:content-['']"
            class:list={[i === 0 ? "bg-white" : "bg-transparent"]}
            data-hero-dot={i}
          />
        ))
      }
    </div>

    <button
      type="button"
      class="-m-3 p-3 text-white/80 transition-colors hover:text-white"
      aria-label="Next slide"
      data-hero-next
    >
      <svg width="10" height="18" viewBox="0 0 10 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L9 9L1 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-hero-slider]");
  if (root) {
    const slideEls = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dotEls = Array.from(root.querySelectorAll<HTMLElement>("[data-hero-dot]"));
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function show(index: number) {
      const next = (index + slideEls.length) % slideEls.length;
      slideEls[current].classList.add("opacity-0", "pointer-events-none");
      slideEls[current].classList.remove("opacity-100");
      dotEls[current].classList.remove("bg-white");
      dotEls[current].classList.add("bg-transparent");
      dotEls[current].setAttribute("aria-selected", "false");

      slideEls[next].classList.remove("opacity-0", "pointer-events-none");
      slideEls[next].classList.add("opacity-100");
      dotEls[next].classList.add("bg-white");
      dotEls[next].classList.remove("bg-transparent");
      dotEls[next].setAttribute("aria-selected", "true");

      current = next;
    }

    function restart() {
      clearInterval(timer);
      timer = setInterval(() => show(current + 1), 6000);
    }

    root.querySelector("[data-hero-prev]")?.addEventListener("click", () => {
      show(current - 1);
      restart();
    });
    root.querySelector("[data-hero-next]")?.addEventListener("click", () => {
      show(current + 1);
      restart();
    });
    dotEls.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        show(i);
        restart();
      }),
    );

    restart();
  }
</script>
