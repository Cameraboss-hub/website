<section class="editorial-hero" data-hero-slider>
  <div class="hero-minimal-title"><p data-story-current>{slides[0].title.join(" ")}</p><h2>Through our lens.<br />Into your story.</h2><a data-story-link href={slides[0].cta?.href}>Explore the stories <span aria-hidden="true">↗</span></a></div>
  <div class="hero-photographs">
    {slides.map((slide,i) => <div class:list={['hero-frame',i===0 ? 'opacity-100' : 'opacity-0 pointer-events-none']} data-slide={i} data-story-title={slide.title.join(" ")} data-story-href={slide.cta?.href} aria-hidden={i!==0} inert={i!==0}>
      <img src={slide.image} alt={`${slide.title.join(' ')} — ${slide.subtitle}`} loading={i===0 ? 'eager' : 'lazy'} fetchpriority={i===0 ? 'high' : 'low'} />
      <div class="hero-caption" inert aria-hidden="true"><p>{slide.subtitle}</p><h2>{slide.title.join(' ')}</h2>{slide.cta && <a href={slide.cta.href}>{slide.cta.label} <span aria-hidden="true">↗</span></a>}</div>
    </div>)}
    <div class="hero-controls"><button type="button" data-hero-prev aria-label="Previous slide">←</button><span class="hero-slide-count" data-story-count>01 / 12</span><div class="hero-dots" role="tablist" aria-label="Slides">{slides.map((_,i)=><button type="button" role="tab" aria-label={`Go to slide ${i+1}`} aria-selected={i===0} data-hero-dot={i} class:list={[i===0?'bg-white':'bg-transparent']} />)}</div><button type="button" data-hero-next aria-label="Next slide">→</button><button type="button" data-hero-pause aria-pressed="false">Pause slideshow</button></div>
  </div>
</section>
<script>
  const root = document.querySelector<HTMLElement>("[data-hero-slider]");
  if (root) {
    const slideEls = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dotEls = Array.from(root.querySelectorAll<HTMLElement>("[data-hero-dot]"));
    let current = 0;
    let timer: ReturnType<typeof setInterval>;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let paused = reducedMotion.matches;
    const pause = root.querySelector<HTMLButtonElement>('[data-hero-pause]');

    function show(index: number) {
      const next = (index + slideEls.length) % slideEls.length;
      slideEls[current].classList.add("opacity-0", "pointer-events-none");
      slideEls[current].classList.remove("opacity-100");
      dotEls[current].classList.remove("bg-white");
      dotEls[current].classList.add("bg-transparent");
      dotEls[current].setAttribute("aria-selected", "false");

      slideEls[next].classList.remove("opacity-0", "pointer-events-none");
      slideEls[next].classList.add("opacity-100");
      dotEls[next].classList.add("bg-white");
      dotEls[next].classList.remove("bg-transparent");
      dotEls[next].setAttribute("aria-selected", "true");

      slideEls.forEach((slide, index) => { slide.inert = index !== next; slide.setAttribute('aria-hidden', String(index !== next)); });
      const title = root!.querySelector<HTMLElement>('[data-story-current]');
      const link = root!.querySelector<HTMLAnchorElement>('[data-story-link]');
      if (title) title.textContent = slideEls[next].dataset.storyTitle || 'CameraBoss / Wedding stories';
      if (link) link.href = slideEls[next].dataset.storyHref || '/client-area/';
      const count = root!.querySelector('[data-story-count]');
      if(count) count.textContent = `${String(next+1).padStart(2,'0')} / ${slideEls.length}`;
      current = next;
    }

    function restart() {
      clearInterval(timer);
      if (!paused && !document.hidden) timer = setInterval(() => show(current + 1), 6000);
      if (pause) { pause.textContent = paused ? 'Play slideshow' : 'Pause slideshow'; pause.setAttribute('aria-pressed', String(paused)); }
    }

    root.querySelector("[data-hero-prev]")?.addEventListener("click", () => {
      show(current - 1);
      restart();
    });
    root.querySelector("[data-hero-next]")?.addEventListener("click", () => {
      show(current + 1);
      restart();
    });
    dotEls.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        show(i);
        restart();
      }),
    );

    pause?.addEventListener('click', () => { paused = !paused; restart(); });
    reducedMotion.addEventListener('change', event => { paused = event.matches; restart(); });
    document.addEventListener('visibilitychange', restart);
    root.addEventListener('focusin', event => { if (event.target === pause) return; paused = true; restart(); });
    restart();
  }
</script>
