---
interface Item {
  image: string;
  title: string;
  subtitle: string;
  href: string;
  span: "full" | "half";
}

const items: Item[] = [
  { image: "/images/portfolio/01-moses-bliss-marie-wiseborn.webp", title: "Moses Bliss and Marie Wiseborn", subtitle: "#MMbliss24", href: "/client-area/", span: "full" },
  { image: "/images/portfolio/02-the-wedding.webp", title: "The Wedding", subtitle: "13 June 2021", href: "/client-area/", span: "half" },
  { image: "/images/portfolio/03-yoruba-wedding.webp", title: "Yoruba Wedding", subtitle: "13 June 2023", href: "/client-area/", span: "half" },
  { image: "/images/portfolio/04-mayo-emmanuel.webp", title: "Mayo and Emmanuel", subtitle: "13 July 2023", href: "/client-area/", span: "full" },
  { image: "/images/portfolio/05-dana-bridal-portraits.webp", title: "Dana Bridal Portraits", subtitle: "The Shoot at Leicester", href: "https://cameraboss.pixieset.com/dana/", span: "half" },
  { image: "/images/portfolio/06-bridal-look.webp", title: "Bridal Look", subtitle: "Grand Hotel Leicester", href: "https://cameraboss.pixieset.com/anyadestinationwedding/", span: "half" },
  { image: "/images/portfolio/07-siri-bridal-portrait.webp", title: "Siri Bridal Portrait", subtitle: "London Uk", href: "https://gallery.cameraboss.co.uk/bridalshoot/", span: "full" },
  { image: "/images/portfolio/08-js-london-wedding.webp", title: "J & S", subtitle: "London Wedding", href: "https://gallery.cameraboss.co.uk/jumokeandstephen/", span: "half" },
  { image: "/images/portfolio/09-bridal-robe-arewa.webp", title: "Bridal Robe", subtitle: "Arewa Wedding", href: "/client-area/", span: "half" },
];

const chapters = [
 { eyebrow: "01 / The celebration", title: "Your people.\nYour story.", text: "From the energy of a Nigerian wedding to a quiet moment before the ceremony, our photographs make room for the people, the culture and the feeling.", href: "/client-area/", link: "Explore the galleries" },
 { eyebrow: "02 / The feeling", title: "More than\na photograph.", text: "The anticipation. The laughter. The people who make it yours. We pay attention to the moments you will want to return to.", href: "/experience/", link: "Our approach" },
 { eyebrow: "03 / The details", title: "A little drama.\nAll you.", text: "Portraits, celebrations and the details in between. A place for your personality in every frame.", href: "/contact/", link: "Tell us your plans" },
];
---

<section class="photo-chapters" aria-label="Selected wedding photography">
 {chapters.map((chapter,chapterIndex)=><article class:list={['photo-chapter', {'chapter-reversed':chapterIndex===1}]}>
   <div class="chapter-mosaic">
    {items.slice(chapterIndex*3,chapterIndex*3+3).map((item,i)=><a href={item.href} class:list={['chapter-photo',`chapter-photo-${i+1}`]} data-reveal>
      <img src={item.image} alt={item.title} loading="lazy" />
      <span class="chapter-photo-caption"><span>{item.title}<small>{item.subtitle}</small></span><span aria-hidden="true">↗</span></span>
    </a>)}
   </div>
   <div class="chapter-statement" data-reveal><p class="eyebrow">{chapter.eyebrow}</p><h2>{chapter.title.split('\n').map(line=><span>{line}</span>)}</h2><p>{chapter.text}</p><a class="text-link" href={chapter.href}>{chapter.link} <span aria-hidden="true">↗</span></a></div>
 </article>)}
 <a class="chapter-all" href="/client-area/">Discover more stories <span aria-hidden="true">↗</span></a>
</section>
