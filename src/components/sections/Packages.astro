---
const packages = [
  {
    eyebrow: "Package 01",
    title: "Wedding Photography Package",
    image: "/images/packages/photography-package.webp",
    alt: "Luxury wedding photography couple portrait",
    body: [
      "At Cameraboss, we turn your wedding day into timeless photographs filled with love, laughter, and emotion.",
      "Whether you're in London, Leicester, Manchester, or celebrating in Nigeria, our expert team is here to tell your story through stunning imagery.",
      "Let's capture the magic — one frame at a time.",
    ],
    boldClosing: "Book your wedding photographer with Cameraboss today.",
    includesLabel: "Includes:",
    includes: ["Pre-wedding Shoot", "300 Edited photos", "40 Pages Album"],
    cta: { label: "View Full Pricing", href: "/pricing" },
    imageFirst: false,
  },
  {
    eyebrow: "Package 02",
    title: "Wedding Videos",
    image: "/images/packages/video-package.webp",
    alt: "Candid wedding photography with natural lighting",
    body: [
      "At Cameraboss, we don't just film weddings — we capture emotions, energy, and the magic in motion. Your love story deserves more than just photos; it deserves a cinematic experience that brings your special day back to life, every time you press play.",
      "Whether you're looking for a London wedding videographer, planning your big day in Leicester or Manchester, or celebrating in Nigeria with our expert videography team, we're here to turn your memories into timeless films.",
      "From heartfelt vows to dance floor moments, our videography style is storytelling with soul. Let's work together to create a wedding film that's as unique and beautiful as your love.",
    ],
    boldClosing: "Ready to make your wedding unforgettable? Start your journey today with Cameraboss Wedding Videography.",
    includesLabel: "Includes:",
    includes: ["Full Wedding Video", "Thriller", "Netflix style Video", "Save the Date Video"],
    cta: { label: "Make Enquiry", href: "/contact" },
    imageFirst: true,
  },
];
---

<section class="editorial-packages bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-[1368px] px-6">
    <p class="eyebrow">Made around your day</p><h2 class="section-title">Photographs to keep.<br /><em>Films to feel.</em></h2>
    <div class="mt-6 h-px w-full bg-[#d9d9d9]" />

    <div class="mt-16 flex flex-col gap-24">
      {
        packages.map((pkg) => (
          <div class="package-row grid items-center gap-12 lg:grid-cols-2" data-reveal>
            <div class:list={["overflow-hidden", pkg.imageFirst && "lg:order-2"]}>
              <img src={pkg.image} alt={pkg.alt} class="h-[420px] w-full rounded-sm object-cover lg:h-[560px]" loading="lazy" />
            </div>

            <div class:list={[pkg.imageFirst && "lg:order-1"]}>
              <p class="text-xs font-medium tracking-[0.1em] text-[#434343] uppercase">{pkg.eyebrow}</p>
              <h4 class="font-display mt-2 text-3xl font-thin text-[#434343] sm:text-4xl">{pkg.title}</h4>

              <div class="mt-6 flex flex-col gap-4">
                {pkg.body.map((p) => (
                  <p class="text-base leading-6 text-[#797979]">{p}</p>
                ))}
                <p class="text-base leading-6 font-bold text-[#797979]">{pkg.boldClosing}</p>
              </div>

              <div class="mt-8">
                <p class="text-sm font-medium tracking-[0.06em] text-[#434343] uppercase">{pkg.includesLabel}</p>
                <ul class="mt-3 flex flex-col gap-1.5">
                  {pkg.includes.map((line) => (
                    <li class="text-base text-[#797979]">{line}</li>
                  ))}
                </ul>
              </div>

              <a
                href={pkg.cta.href}
                class="mt-8 inline-block rounded-full border border-[#434343] px-8 py-3.5 text-xs font-semibold tracking-[0.1em] text-[#434343] uppercase transition-colors hover:bg-[#434343] hover:text-white"
              >
                {pkg.cta.label}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
